# Supabase – diese Werte findest du in deinem Supabase-Projekt
# unter: Project Settings -> API
# Trage sie in Vercel unter Settings -> Environment Variables ein.

NEXT_PUBLIC_SUPABASE_URL=https://dein-projekt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=dein-anon-key

# Brevo (E-Mail-Marketing) – für Newsletter-Anmeldungen
# BREVO_API_KEY: Dein Brevo API-Key (unter Account -> API Keys)
# BREVO_LIST_ID: Die ID deiner Newsletter-Liste (unter Contacts -> Lists)
# Beide Werte sind OPTIONAL – ohne sie funktioniert der Newsletter nur mit Supabase.

BREVO_API_KEY=dein-brevo-api-key
BREVO_LIST_ID=deine-list-id
